# 기본값 그대로 사용해도 됩니다.
aws_region        = "ap-northeast-2"
availability_zone = "ap-northeast-2a"

project_name = "cal-ml"
environment  = "dev"

instance_type         = "g6.2xlarge"
root_volume_size      = 100
data_volume_size      = 300
data_volume_iops      = 3000
data_volume_throughput = 125

# SSM 사용이 기본. SSH는 열지 않습니다.
enable_ssh = false

jupyter_port        = 8888
install_ml_packages = true

# S3 데이터 보호: true로 바꾸면 destroy 시 S3 객체/Version도 함께 제거할 수 있습니다.
s3_force_destroy = false

# 선택: 빈 문자열이면 Budget 리소스를 만들지 않습니다.
budget_email       = ""
monthly_budget_usd = 250
