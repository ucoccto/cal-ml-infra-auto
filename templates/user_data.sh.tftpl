#!/bin/bash
# ============================================================================
# CAL ML EC2 Early Bootstrap
# 목적: EC2 부팅 직후 SSM Agent를 최대한 빨리 Online 상태로 만든다.
# 전체 ML/Jupyter 설치는 Terraform의 aws_ssm_association.bootstrap이 담당한다.
# 로그: /var/log/cal-user-data.log
# ============================================================================
set -Eeuo pipefail
exec > >(tee -a /var/log/cal-user-data.log) 2>&1

echo "===== CAL ML early bootstrap start: $(date -Is) ====="

start_ssm_agent() {
  # 일반 systemd 패키지 형태
  if systemctl list-unit-files 2>/dev/null | grep -q '^amazon-ssm-agent.service'; then
    systemctl enable amazon-ssm-agent.service || true
    systemctl restart amazon-ssm-agent.service || systemctl start amazon-ssm-agent.service
    return 0
  fi

  # Ubuntu AWS AMI에서 일반적으로 사용하는 Snap 형태
  if command -v snap >/dev/null 2>&1; then
    if ! snap list amazon-ssm-agent >/dev/null 2>&1; then
      echo "SSM Agent가 없어 Snap으로 설치합니다."
      snap install amazon-ssm-agent --classic
    fi

    snap start amazon-ssm-agent || \
      systemctl restart snap.amazon-ssm-agent.amazon-ssm-agent.service || true
    return 0
  fi

  echo "WARNING: SSM Agent 실행 방법을 찾지 못했습니다."
  return 1
}

start_ssm_agent || true

# 서비스가 실제 active 상태인지 잠시 확인한다.
for attempt in $(seq 1 24); do
  if systemctl is-active --quiet amazon-ssm-agent.service 2>/dev/null || \
     systemctl is-active --quiet snap.amazon-ssm-agent.amazon-ssm-agent.service 2>/dev/null; then
    echo "SSM Agent active"
    break
  fi
  echo "SSM Agent 시작 대기 중... ($attempt/24)"
  sleep 5
done

echo "===== CAL ML early bootstrap end: $(date -Is) ====="
