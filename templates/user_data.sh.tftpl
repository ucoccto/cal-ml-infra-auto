#!/bin/bash
# ============================================================================
# CAL ML EC2 Bootstrap
# Terraform에서 EC2를 생성한 직후 자동으로 실행되는 초기화 스크립트다.
# 실패/진행 상황은 /var/log/cal-bootstrap.log 에 기록한다.
# ============================================================================
set -Eeuo pipefail

exec > >(tee -a /var/log/cal-bootstrap.log) 2>&1

echo "===== CAL ML bootstrap start: $(date -Is) ====="

PROJECT_NAME="${project_name}"
S3_BUCKET="${s3_bucket}"
AWS_REGION="${aws_region}"
DATA_VOLUME_ID="${data_volume_id}"
JUPYTER_PORT="${jupyter_port}"
INSTALL_ML_PACKAGES="${install_ml_packages}"

APP_USER="ubuntu"
WORKSPACE="/workspace"
PROJECT_DIR="$WORKSPACE/cal-project"
VENV_DIR="$WORKSPACE/venv"

# ----------------------------------------------------------------------------
# 1. 기본 시스템 패키지
# ----------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y \
  python3-venv python3-pip python3-dev build-essential \
  git curl wget unzip jq htop tmux nvme-cli \
  ca-certificates

# DLAMI에는 AWS CLI가 보통 포함되어 있지만, 없는 경우 Ubuntu 패키지로 보완한다.
if ! command -v aws >/dev/null 2>&1; then
  apt-get install -y awscli
fi

# SSM Agent가 설치되어 있다면 서비스가 실행 중인지 확인한다.
# DLAMI 릴리스에 따라 systemd unit 이름이 다를 수 있어 두 가지를 모두 확인한다.
if systemctl list-unit-files | grep -q '^amazon-ssm-agent.service'; then
  systemctl enable --now amazon-ssm-agent
elif systemctl list-unit-files | grep -q '^snap.amazon-ssm-agent.amazon-ssm-agent.service'; then
  systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent
fi

# ----------------------------------------------------------------------------
# 2. Data EBS를 /workspace에 자동 마운트
# ----------------------------------------------------------------------------
# Nitro 인스턴스에서 /dev/sdf는 실제로 /dev/nvme*n1처럼 보일 수 있다.
# 그래서 Terraform이 생성한 EBS Volume ID의 serial을 이용해 실제 장치를 찾는다.
DATA_SERIAL=$(echo "$DATA_VOLUME_ID" | tr -d '-')
DATA_DEVICE=""

for attempt in $(seq 1 60); do
  DATA_DEVICE=$(lsblk -ndo NAME,SERIAL 2>/dev/null | awk -v serial="$DATA_SERIAL" '$2 == serial {print "/dev/"$1; exit}')
  if [ -n "$DATA_DEVICE" ] && [ -b "$DATA_DEVICE" ]; then
    break
  fi
  echo "Data EBS attach 대기 중... ($attempt/60)"
  sleep 5
done

if [ -z "$DATA_DEVICE" ] || [ ! -b "$DATA_DEVICE" ]; then
  echo "ERROR: Data EBS 장치를 찾지 못했습니다: $DATA_VOLUME_ID"
  exit 1
fi

echo "Data EBS device: $DATA_DEVICE"

# 파일시스템이 없는 새 볼륨일 때만 ext4로 포맷한다.
# 이미 데이터가 있는 볼륨은 절대 다시 포맷하지 않는다.
if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  echo "새 Data EBS이므로 ext4 파일시스템을 생성합니다."
  mkfs.ext4 -F "$DATA_DEVICE"
fi

mkdir -p "$WORKSPACE"
DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")

# 재부팅 후에도 같은 EBS가 /workspace에 자동 마운트되도록 /etc/fstab에 UUID를 기록한다.
if ! grep -q "$DATA_UUID" /etc/fstab; then
  echo "UUID=$DATA_UUID $WORKSPACE ext4 defaults,nofail 0 2" >> /etc/fstab
fi

mount "$WORKSPACE" || mount -a
chown "$APP_USER:$APP_USER" "$WORKSPACE"

# ----------------------------------------------------------------------------
# 3. G6 Instance Store(NVMe) 캐시 디렉터리 준비
# ----------------------------------------------------------------------------
# AWS DLAMI는 지원되는 인스턴스의 Local NVMe를 /opt/dlami/nvme에 준비한다.
# 이 공간은 매우 빠르지만 EC2 Stop/Terminate 시 데이터가 보존되지 않을 수 있으므로
# 학습 cache/temp 용도로만 사용한다.
LOCAL_NVME="/opt/dlami/nvme"
CACHE_TARGET="$WORKSPACE/cache"

# DLAMI의 자동 NVMe mount service가 존재하면 먼저 실행 상태를 보장한다.
if systemctl list-unit-files | grep -q '^dlami-nvme.service'; then
  systemctl enable --now dlami-nvme.service || true
fi

# NVMe mount가 cloud-init과 동시에 진행될 수 있으므로 잠시 기다린다.
for attempt in $(seq 1 12); do
  if [ -d "$LOCAL_NVME" ] && mountpoint -q "$LOCAL_NVME"; then
    break
  fi
  sleep 5
done

if [ -d "$LOCAL_NVME" ] && mountpoint -q "$LOCAL_NVME"; then
  mkdir -p "$LOCAL_NVME/$PROJECT_NAME-cache"
  chown -R "$APP_USER:$APP_USER" "$LOCAL_NVME/$PROJECT_NAME-cache"

  rm -rf "$CACHE_TARGET"
  ln -s "$LOCAL_NVME/$PROJECT_NAME-cache" "$CACHE_TARGET"
  echo "Local NVMe cache: $CACHE_TARGET -> $LOCAL_NVME/$PROJECT_NAME-cache"
else
  # Instance Store가 없는 인스턴스 타입으로 변경해도 동작하도록 EBS fallback을 만든다.
  mkdir -p "$CACHE_TARGET"
  chown -R "$APP_USER:$APP_USER" "$CACHE_TARGET"
  echo "Local NVMe를 찾지 못해 EBS의 $CACHE_TARGET 을 cache로 사용합니다."
fi

# ----------------------------------------------------------------------------
# 4. S3의 Project Template을 EBS로 다운로드
# ----------------------------------------------------------------------------
mkdir -p "$PROJECT_DIR"

# IAM/S3 API의 일시적인 초기화 지연에도 견디도록 여러 번 재시도한다.
SYNC_OK=false
for attempt in $(seq 1 12); do
  if aws s3 sync "s3://$S3_BUCKET/bootstrap/project-template/" "$PROJECT_DIR/" --region "$AWS_REGION"; then
    SYNC_OK=true
    break
  fi
  echo "Project template S3 sync 재시도... ($attempt/12)"
  sleep 10
done

if [ "$SYNC_OK" != "true" ]; then
  echo "ERROR: S3 project template 다운로드에 실패했습니다."
  exit 1
fi

chown -R "$APP_USER:$APP_USER" "$PROJECT_DIR"

# 프로젝트에서 자주 사용하는 경로를 준비한다.
mkdir -p \
  "$PROJECT_DIR/checkpoints" \
  "$PROJECT_DIR/outputs" \
  "$PROJECT_DIR/logs" \
  "$PROJECT_DIR/data"
chown -R "$APP_USER:$APP_USER" "$PROJECT_DIR"

# data/cache는 빠른 Local NVMe 영역을 사용하도록 별도 링크를 제공한다.
rm -rf "$PROJECT_DIR/data/cache"
ln -s "$CACHE_TARGET" "$PROJECT_DIR/data/cache"

# ----------------------------------------------------------------------------
# 5. Python 가상환경 및 ML/Jupyter 패키지 설치
# ----------------------------------------------------------------------------
if [ ! -d "$VENV_DIR" ]; then
  sudo -u "$APP_USER" python3 -m venv "$VENV_DIR"
fi

sudo -u "$APP_USER" "$VENV_DIR/bin/python" -m pip install --upgrade pip setuptools wheel

if [ "$INSTALL_ML_PACKAGES" = "true" ]; then
  echo "Python/ML 패키지 설치를 시작합니다."
  sudo -u "$APP_USER" "$VENV_DIR/bin/pip" install -r "$PROJECT_DIR/requirements.txt"
else
  # ML 패키지 전체 설치를 건너뛰더라도 JupyterLab은 사용할 수 있게 한다.
  sudo -u "$APP_USER" "$VENV_DIR/bin/pip" install jupyterlab ipykernel boto3
fi

# ----------------------------------------------------------------------------
# 6. 프로젝트 환경변수 등록
# ----------------------------------------------------------------------------
cat > /etc/profile.d/cal-project.sh <<EOF_ENV
export CAL_PROJECT_DIR="$PROJECT_DIR"
export CAL_S3_BUCKET="$S3_BUCKET"
export CAL_AWS_REGION="$AWS_REGION"
export CAL_CACHE_DIR="$CACHE_TARGET"
export PATH="$VENV_DIR/bin:\$PATH"
EOF_ENV
chmod 0644 /etc/profile.d/cal-project.sh

# Jupyter에서 프로젝트 venv를 명확한 Kernel 이름으로 선택할 수 있게 등록한다.
sudo -u "$APP_USER" "$VENV_DIR/bin/python" -m ipykernel install \
  --user \
  --name cal-ml \
  --display-name "CAL ML (Python)"

# ----------------------------------------------------------------------------
# 7. JupyterLab을 systemd 서비스로 등록
# ----------------------------------------------------------------------------
# 보안상 0.0.0.0이 아니라 127.0.0.1에만 바인딩한다.
# 사용자는 AWS SSM Port Forwarding을 통해 localhost:8888로 접속한다.
JUPYTER_CONFIG_DIR="$WORKSPACE/.jupyter"
mkdir -p "$JUPYTER_CONFIG_DIR"
chown -R "$APP_USER:$APP_USER" "$JUPYTER_CONFIG_DIR"

cat > "$JUPYTER_CONFIG_DIR/jupyter_server_config.py" <<EOF_JUPYTER
c.ServerApp.ip = "127.0.0.1"
c.ServerApp.port = $JUPYTER_PORT
c.ServerApp.open_browser = False
c.ServerApp.root_dir = "$PROJECT_DIR"
c.ServerApp.allow_remote_access = False
# Jupyter 자체 인증은 비활성화하되 서버를 loopback에만 bind한다.
# 실제 원격 사용자 인증/터널은 AWS SSM Session Manager가 담당한다.
c.IdentityProvider.token = ""
EOF_JUPYTER
chown "$APP_USER:$APP_USER" "$JUPYTER_CONFIG_DIR/jupyter_server_config.py"

cat > /etc/systemd/system/cal-jupyter.service <<EOF_SERVICE
[Unit]
Description=CAL ML JupyterLab
After=network-online.target
Wants=network-online.target
RequiresMountsFor=$WORKSPACE

[Service]
Type=simple
User=$APP_USER
Group=$APP_USER
WorkingDirectory=$PROJECT_DIR
Environment=CAL_PROJECT_DIR=$PROJECT_DIR
Environment=CAL_S3_BUCKET=$S3_BUCKET
Environment=CAL_AWS_REGION=$AWS_REGION
Environment=CAL_CACHE_DIR=$CACHE_TARGET
ExecStart=$VENV_DIR/bin/jupyter lab --config=$JUPYTER_CONFIG_DIR/jupyter_server_config.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF_SERVICE

systemctl daemon-reload
systemctl enable --now cal-jupyter.service

# ----------------------------------------------------------------------------
# 8. GPU / Python 환경 Smoke Test
# ----------------------------------------------------------------------------
{
  echo "===== SYSTEM ====="
  uname -a
  echo
  echo "===== NVIDIA ====="
  nvidia-smi || true
  echo
  echo "===== STORAGE ====="
  lsblk
  df -h
  echo
  echo "===== PYTHON ====="
  "$VENV_DIR/bin/python" --version
  "$VENV_DIR/bin/python" "$PROJECT_DIR/scripts/gpu_check.py" || true
  echo
  echo "===== JUPYTER ====="
  systemctl --no-pager --full status cal-jupyter.service || true
} > "$WORKSPACE/bootstrap-status.txt" 2>&1

chown "$APP_USER:$APP_USER" "$WORKSPACE/bootstrap-status.txt"

echo "===== CAL ML bootstrap complete: $(date -Is) ====="
echo "Status: $WORKSPACE/bootstrap-status.txt"
echo "Jupyter: localhost:$JUPYTER_PORT (SSM Port Forwarding 사용)"
